{
  "name": "bumboo-agent-controller",
  "version": "0.2.0",
  "private": true,
  "description": "Portable local controller for Hermes Agent profiles on Windows + WSL",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179",
    "electron": "electron .",
    "start": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis portable",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "electron-builder": "latest",
    "electron": "latest",
    "vite": "latest",
    "@vitejs/plugin-react": "latest"
  },
  "build": {
    "appId": "com.bumboo.agent-controller",
    "productName": "BumBoo Agent Controller",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
